{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stretchbreak.dev/schema/stretch.schema.json",
  "title": "StretchBreak stretch record",
  "type": "object",
  "required": [
    "id",
    "name",
    "area",
    "posture",
    "duration_s",
    "tier",
    "cue",
    "steps",
    "counter",
    "hands_free",
    "contra"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case, unique within the pack. Namespaced as <pack>/<id> at load time."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "area": {
      "enum": [
        "neck",
        "shoulders",
        "upper-back",
        "wrists",
        "hands",
        "hips",
        "lower-back",
        "eyes",
        "full-body"
      ]
    },
    "posture": {
      "enum": [
        "seated",
        "standing",
        "either"
      ]
    },
    "duration_s": {
      "type": "integer",
      "minimum": 3,
      "maximum": 300
    },
    "tier": {
      "enum": [
        "micro",
        "short",
        "medium",
        "long"
      ],
      "description": "micro \u226410s, short 11\u201330s, medium 31\u201359s, long \u226560s. Must match duration_s unless the record sets tier_override: true."
    },
    "tier_override": {
      "type": "boolean",
      "default": false
    },
    "cue": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140,
      "description": "One line the user can follow on its own. Include what to do and for how long."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 15
      },
      "minItems": 2,
      "maxItems": 8,
      "description": "Precise, ordered instructions. Each step is one action with position, direction and timing where relevant. Written to be followed without a picture."
    },
    "counter": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The desk habit or load this stretch counteracts, e.g. forward-head, pec-shortening."
    },
    "hands_free": {
      "type": "boolean",
      "description": "True if it can be done without letting go of keyboard/mouse. Required true for micro tier."
    },
    "contra": {
      "type": "array",
      "items": {
        "enum": [
          "neck-injury",
          "shoulder-injury",
          "wrist-injury",
          "back-injury",
          "hip-injury",
          "knee-injury",
          "ankle-injury",
          "pregnancy",
          "low-blood-pressure",
          "vertigo",
          "recent-surgery"
        ]
      },
      "uniqueItems": true
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Optional reference link (a video or page). Never required; StretchBreak is text-first."
        }
      }
    },
    "feel": {
      "type": "string",
      "minLength": 15,
      "maxLength": 240,
      "description": "What the user should feel when doing it right. Required in the default pack."
    },
    "avoid": {
      "type": "string",
      "minLength": 15,
      "maxLength": 300,
      "description": "Common mistakes and stop conditions. Required in the default pack."
    }
  }
}